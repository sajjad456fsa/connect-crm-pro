generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_AGENT
  SUPPORT_STAFF
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  INTERESTED
  QUALIFIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  FOLLOW_UP
  WAITING_RESPONSE
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  COLD_CALL
  EMAIL_CAMPAIGN
  TRADE_SHOW
  PARTNER
  OTHER
}

enum LostReason {
  PRICE_TOO_HIGH
  COMPETITOR
  TIMING_NOT_RIGHT
  NO_NEED
  BAD_TIMING
  LOST_CONTACT
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum FileCategory {
  LEAD
  CUSTOMER
  TASK
  SETTINGS
}

model Role {
  id        String   @id @default(cuid())
  name      RoleType @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String
  password          String
  role              RoleType      @default(SALES_AGENT)
  active            Boolean       @default(true)
  emailVerified     Boolean       @default(false)
  twoFactorEnabled  Boolean       @default(false)
  refreshToken      String?       @default(null)
  lastLogin         DateTime?
  createdAt         DateTime      @default(now())

  // Relations
  assignedLeads     Lead[]        @relation("AssignedLeads")
  leadsAssignedBy   Lead[]        @relation("LeadAssignedBy")
  tasks             Task[]        @relation("AssignedTasks")
  messages          Message[]
  activities        Activity[]
  leadActivities    LeadActivity[]
  notifications     Notification[]
}

model Lead {
  id                    String          @id @default(cuid())
  leadId                String          @unique @default(cuid())
  fullName              String
  companyName           String?
  email                 String
  phone                 String?
  whatsapp              String?
  leadSource            LeadSource?
  status                LeadStatus      @default(NEW_LEAD)
  priority              Priority        @default(MEDIUM)
  budgetValue           Float?          @default(0)
  country               String?
  city                  String?
  address               String?
  notes                 String?
  tags                  String[]        @default([])
  followUpDate          DateTime?
  nextMeetingDate       DateTime?
  assignedSalesPerson   User?           @relation("AssignedLeads", fields: [assignedSalesPersonId], references: [id])
  assignedSalesPersonId String?
  assignedBy            User?           @relation("LeadAssignedBy", fields: [assignedById], references: [id])
  assignedById          String?
  leadAssignedDate      DateTime?
  lastUpdatedDate       DateTime        @updatedAt
  leadProgressPercent   Int             @default(0)
  expectedClosingDate   DateTime?
  dealValue             Float?          @default(0)
  conversionProbability Int?            @default(0)
  lostReason            LostReason?
  lostReasonNotes       String?

  // Relations
  activities            LeadActivity[]
  files                 File[]
  tasks                 Task[]
  notifications         Notification[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // e.g., "created", "assigned", "status_changed", "note_added", "call_logged", etc.
  description String
  oldValue    String?
  newValue    String?
  metadata    Json?    // Additional data like call duration, email subject, etc.
  createdAt   DateTime @default(now())
}

model Customer {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  billingInfo  String?
  company      String?
  projectHistory String?
  documents    File[]
  tasks        Task[]
  notes        Note[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  priority     Priority     @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedToId String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  customerId   String?
  lead         Lead?        @relation(fields: [leadId], references: [id])
  leadId       String?
  comments     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Note {
  id        String    @id @default(cuid())
  text      String
  customer  Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  createdAt DateTime  @default(now())
}

model Activity {
  id        String    @id @default(cuid())
  type      String
  message   String
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  leadId    String?
  createdAt DateTime  @default(now())
}

enum NotificationType {
  LEAD_ASSIGNED
  LEAD_UPDATED
  FOLLOW_UP_DUE
  LEAD_WON
  LEAD_LOST
  HIGH_PRIORITY_LEAD
  SALES_INACTIVE
  BOSS_COMMENT
  STATUS_CHANGED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  GENERAL
}

model Notification {
  id        String            @id @default(cuid())
  type      NotificationType  @default(GENERAL)
  title     String
  body      String
  user      User?             @relation(fields: [userId], references: [id])
  userId    String?
  lead      Lead?             @relation(fields: [leadId], references: [id])
  leadId    String?
  read      Boolean           @default(false)
  priority  Priority          @default(MEDIUM)
  metadata  Json?             // Additional data for the notification
  createdAt DateTime          @default(now())
}

model File {
  id         String      @id @default(cuid())
  filename   String
  url        String
  category   FileCategory
  lead       Lead?       @relation(fields: [leadId], references: [id])
  leadId     String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerId String?
  task       Task?       @relation(fields: [taskId], references: [id])
  taskId     String?
  createdAt  DateTime    @default(now())
}

model Message {
  id         String      @id @default(cuid())
  subject    String
  body       String
  senderId   String
  sender     User        @relation(fields: [senderId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerId String?
  createdAt  DateTime    @default(now())
}

model Setting {
  id            String   @id @default(cuid())
  companyName   String   @default("Connect CRM Pro")
  companyEmail  String?
  brandColor    String?  @default("#0d9488")
  logoUrl       String?
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String?
  apiKeys       String[] @default([])
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
